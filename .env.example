# =============================================================
# Jovens Buzz — Frontend configuration (copy to .env.local)
# Only NEXT_PUBLIC_* values reach the browser; never put secrets in them.
# =============================================================

# Canonical public URL of the site (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Spring Boot API as reached from the BROWSER (public enquiry form)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081

# Spring Boot API as reached from the Next.js SERVER (admin proxy, page data).
# Server-only: may be an internal address in production.
API_INTERNAL_URL=http://localhost:8081

# Seconds public content (services, FAQs, copy) is cached before background refresh.
# Admin edits revalidate immediately regardless.
CONTENT_REVALIDATE_SECONDS=300

# Business time zone used for "today"/"this month" and daily trend buckets
BUSINESS_TIMEZONE=America/Chicago

# Automatic Contact Popup
NEXT_PUBLIC_CONTACT_POPUP_ENABLED=true
NEXT_PUBLIC_CONTACT_POPUP_DELAY_MS=5000
NEXT_PUBLIC_CONTACT_POPUP_SESSION_ONCE=false

